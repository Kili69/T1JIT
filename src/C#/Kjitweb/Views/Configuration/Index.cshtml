@model ConfigurationEditorViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<KjitWeb.SharedResource> L

@{
    ViewData["Title"] = L["ConfigurationPageTitle"];
    var activeTab = Model.ActiveTab is "delegation" or "advanced" ? Model.ActiveTab : "jit";
    var jitActive = activeTab == "jit";
    var advancedActive = activeTab == "advanced";
    var delegationActive = activeTab == "delegation";
    var globalParameterNames = new HashSet<string>(
        ["Domain", "T1Searchbase"],
        StringComparer.OrdinalIgnoreCase);
    var globalParameterIndexes = Enumerable.Range(0, Model.JitParameters.Count)
        .Where(index => globalParameterNames.Contains(Model.JitParameters[index].Name))
        .ToList();
    var standardParameterIndexes = Enumerable.Range(0, Model.JitParameters.Count)
        .Where(index => !Model.JitParameters[index].IsAdvanced
            && !globalParameterNames.Contains(Model.JitParameters[index].Name))
        .ToList();
    var advancedParameterPriority = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase)
    {
        ["ConfigScriptVersion"] = 0,
        ["Tier0ServerGroupName"] = 1,
        ["LDAPT0ComputerPath"] = 2,
        ["OU"] = 3,
        ["GroupManagementTaskRerun"] = 4
    };
    var hiddenAdvancedParameterNames = new HashSet<string>(
        [
            "ElevateEventID",
            "EventSource",
            "EventLog",
            "GroupManagedServiceAccountName",
            "EnableDelegation",
            "DomainSeparator",
            "EnableMultiDomainSupport"
        ],
        StringComparer.OrdinalIgnoreCase);
    var advancedParameterIndexes = Enumerable.Range(0, Model.JitParameters.Count)
        .Where(index => Model.JitParameters[index].IsAdvanced
            && !hiddenAdvancedParameterNames.Contains(Model.JitParameters[index].Name))
        .OrderBy(index => advancedParameterPriority.TryGetValue(
            Model.JitParameters[index].Name,
            out var priority) ? priority : int.MaxValue)
        .ThenBy(index => index)
        .ToList();
}

<h1 class="h4 mb-3">@L["ConfigurationHeading"]</h1>
<p class="text-muted mb-3">@L["SignedInAs"]: @User.Identity?.Name</p>

@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <div class="alert alert-success" role="status">@Model.SuccessMessage</div>
}

<div class="configuration-editor">
    <div class="configuration-tabs" role="tablist" aria-label="@L["ConfigurationTabsLabel"]">
        <button type="button"
                class="configuration-tab @(jitActive ? "is-active" : "")"
                id="jit-tab"
                role="tab"
                aria-selected="@(jitActive ? "true" : "false")"
                aria-controls="jit-panel"
                data-configuration-tab="jit">
            @L["JitConfigurationTab"]
        </button>
        <button type="button"
                class="configuration-tab @(delegationActive ? "is-active" : "")"
                id="delegation-tab"
                role="tab"
                aria-selected="@(delegationActive ? "true" : "false")"
                aria-controls="delegation-panel"
                data-configuration-tab="delegation">
            @L["DelegationConfigurationTab"]
        </button>
        <button type="button"
                class="configuration-tab @(advancedActive ? "is-active" : "")"
                id="advanced-tab"
                role="tab"
                aria-selected="@(advancedActive ? "true" : "false")"
                aria-controls="advanced-panel"
                data-configuration-tab="advanced">
            @L["AdvancedConfigurationTab"]
        </button>
    </div>

    <form asp-action="SaveJit" method="post">
        <input type="hidden" name="ExpectedHash" value="@Model.JitConfigHash" />
        @for (var index = 0; index < Model.JitParameters.Count; index++)
        {
            var parameter = Model.JitParameters[index];
            if (hiddenAdvancedParameterNames.Contains(parameter.Name))
            {
                <input type="hidden" name="Parameters[@index].Name" value="@parameter.Name" />
                <input type="hidden" name="Parameters[@index].Kind" value="@parameter.Kind" />
                <input type="hidden" name="Parameters[@index].Value" value="@parameter.Value" />
            }
        }
        <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <section class="configuration-panel @(jitActive ? "" : "d-none")"
             id="jit-panel"
             role="tabpanel"
             aria-labelledby="jit-tab"
             data-configuration-panel="jit">
            <section class="configuration-section" aria-labelledby="global-configuration-heading">
                <h2 class="configuration-section-heading" id="global-configuration-heading">@L["GlobalConfigurationHeading"]</h2>
                <div class="configuration-parameter-grid">
                    @foreach (var index in globalParameterIndexes)
                    {
                        var parameter = Model.JitParameters[index];
                        <partial name="_JitConfigurationParameter"
                                 model="@(new JitConfigurationParameterFieldViewModel { Parameter = parameter, Index = index })" />
                    }
                </div>
            </section>

            <section class="configuration-section" aria-labelledby="jit-parameters-heading">
                <h2 class="configuration-section-heading" id="jit-parameters-heading">@L["JitParametersHeading"]</h2>
                <div class="configuration-parameter-grid">
                    @foreach (var index in standardParameterIndexes)
                    {
                        var parameter = Model.JitParameters[index];
                        <partial name="_JitConfigurationParameter"
                                 model="@(new JitConfigurationParameterFieldViewModel { Parameter = parameter, Index = index })" />
                    }
                </div>
            </section>

            <button type="submit" class="btn btn-primary mt-3">@L["SaveJitConfigurationButton"]</button>

        <dialog class="delegation-picker-dialog"
                id="configuration-domain-dialog"
                aria-labelledby="configuration-domain-picker-title"
                aria-describedby="configuration-domain-picker-description"
                data-configuration-domain-picker>
            <div class="delegation-picker-header">
                <div>
                    <div class="delegation-card-eyebrow">Active Directory</div>
                    <h2 class="h5 mb-0" id="configuration-domain-picker-title">@L["DomainPickerTitle"]</h2>
                </div>
                <button type="button" class="kjit-dialog-close" data-close-configuration-domain-picker aria-label="@L["CloseButton"]">
                    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m7 7 10 10" /><path d="m17 7-10 10" /></svg>
                </button>
            </div>
            <div class="delegation-picker-body">
                <p class="text-secondary mb-3" id="configuration-domain-picker-description">@L["DomainPickerDescription"]</p>
                <div class="delegation-tree-status" role="status" data-configuration-domain-status></div>
                <div class="configuration-picker-options" role="listbox" aria-label="@L["DomainPickerTitle"]" data-configuration-domain-options></div>
            </div>
            <div class="delegation-picker-footer">
                <button type="button" class="btn btn-outline-secondary" data-close-configuration-domain-picker>@L["DelegationPickerCancel"]</button>
                <button type="button" class="btn btn-primary" disabled data-select-configuration-domain>@L["DelegationPickerSelect"]</button>
            </div>
        </dialog>

        <dialog class="delegation-picker-dialog"
                id="configuration-ou-dialog"
                aria-labelledby="configuration-ou-picker-title"
                aria-describedby="configuration-ou-picker-description"
                data-configuration-ou-picker>
            <div class="delegation-picker-header">
                <div>
                    <div class="delegation-card-eyebrow">Active Directory</div>
                    <h2 class="h5 mb-0" id="configuration-ou-picker-title">@L["OrganizationalUnitPickerTitle"]</h2>
                </div>
                <button type="button" class="kjit-dialog-close" data-close-configuration-ou-picker aria-label="@L["CloseButton"]">
                    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m7 7 10 10" /><path d="m17 7-10 10" /></svg>
                </button>
            </div>
            <div class="delegation-picker-body">
                <p class="text-secondary mb-3" id="configuration-ou-picker-description">@L["OrganizationalUnitPickerDescription"]</p>
                <div class="delegation-tree-status" role="status" data-configuration-ou-status></div>
                <div class="delegation-tree" role="tree" aria-label="@L["OrganizationalUnitPickerTitle"]" data-configuration-ou-tree></div>
            </div>
            <div class="delegation-picker-footer">
                <button type="button" class="btn btn-outline-secondary" data-close-configuration-ou-picker>@L["DelegationPickerCancel"]</button>
                <button type="button" class="btn btn-primary" disabled data-select-configuration-ou>@L["DelegationPickerSelect"]</button>
            </div>
        </dialog>
    </section>

    <section class="configuration-panel @(advancedActive ? "" : "d-none")"
             id="advanced-panel"
             role="tabpanel"
             aria-labelledby="advanced-tab"
             data-configuration-panel="advanced">
        <h2 class="configuration-section-heading">@L["AdvancedConfigurationHeading"]</h2>
        <p class="configuration-advanced-description">@L["AdvancedConfigurationDescription"]</p>
        <div class="configuration-parameter-grid mt-3">
            @foreach (var index in advancedParameterIndexes)
            {
                var parameter = Model.JitParameters[index];
                <partial name="_JitConfigurationParameter"
                         model="@(new JitConfigurationParameterFieldViewModel { Parameter = parameter, Index = index })" />
            }
        </div>
        <button type="submit" class="btn btn-primary mt-3">@L["SaveJitConfigurationButton"]</button>
    </section>
    </form>

    <section class="configuration-panel @(delegationActive ? "" : "d-none")"
             id="delegation-panel"
             role="tabpanel"
             aria-labelledby="delegation-tab"
             data-configuration-panel="delegation">
        <form asp-action="SaveDelegation" method="post">
            <input type="hidden" name="ExpectedHash" value="@Model.DelegationConfigHash" />
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <div class="delegation-list" data-delegation-list>
                @for (var delegationIndex = 0; delegationIndex < Model.Delegations.Count; delegationIndex++)
                {
                    var delegation = Model.Delegations[delegationIndex];
                    <article class="delegation-card" data-delegation>
                        <header class="delegation-card-header">
                            <div class="min-w-0">
                                <div class="delegation-card-eyebrow">@L["DelegationTargetLabel"]</div>
                                <h3 class="delegation-card-title">@delegation.ComputerOu</h3>
                            </div>
                            <button type="button"
                                    class="delegation-icon-button delegation-remove-delegation"
                                    data-remove-delegation
                                    title="@L["DeleteDelegationButton"]"
                                    aria-label="@L["DeleteDelegationButton"]">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M3 6h18" />
                                    <path d="M8 6V4h8v2" />
                                    <path d="M19 6l-1 14H6L5 6" />
                                    <path d="M10 11v5M14 11v5" />
                                </svg>
                            </button>
                            <input type="hidden"
                                   name="Delegations[@delegationIndex].ComputerOu"
                                   value="@delegation.ComputerOu"
                                   data-delegation-ou />
                        </header>

                        <div class="delegation-object-list" data-delegation-object-list>
                            @for (var objectIndex = 0; objectIndex < delegation.AdObjects.Count; objectIndex++)
                            {
                                var adObject = delegation.AdObjects[objectIndex];
                                <div class="delegation-object" data-delegation-object>
                                    <span class="delegation-object-icon is-@adObject.Kind.ToString().ToLowerInvariant()" aria-hidden="true">
                                        @if (adObject.Kind == DelegationAdObjectKind.Group)
                                        {
                                            <svg viewBox="0 0 24 24">
                                                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                                                <circle cx="9" cy="7" r="4" />
                                                <path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
                                            </svg>
                                        }
                                        else
                                        {
                                            <svg viewBox="0 0 24 24">
                                                <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
                                                <circle cx="12" cy="7" r="4" />
                                            </svg>
                                        }
                                    </span>
                                    <div class="delegation-object-details">
                                        <strong>@adObject.DisplayName</strong>
                                        <span>@adObject.SecurityIdentifier</span>
                                    </div>
                                    <input type="hidden"
                                           name="Delegations[@delegationIndex].AdObjects[@objectIndex].SecurityIdentifier"
                                           value="@adObject.SecurityIdentifier"
                                           data-delegation-object-sid />
                                    <button type="button"
                                            class="delegation-icon-button"
                                            data-remove-delegation-object
                                            title="@L["RemoveAdObjectButton"]"
                                            aria-label="@L["RemoveAdObjectButton"]">
                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M3 6h18" />
                                            <path d="M8 6V4h8v2" />
                                            <path d="M19 6l-1 14H6L5 6" />
                                        </svg>
                                    </button>
                                </div>
                            }
                        </div>
                        <div class="delegation-empty @(delegation.AdObjects.Count == 0 ? "" : "d-none")" data-delegation-empty>
                            @L["DelegationNoAdObjects"]
                        </div>
                        <div class="delegation-add-object input-group">
                            <input type="text"
                                   class="form-control"
                                   placeholder="@L["DelegationAdObjectPlaceholder"]"
                                   aria-label="@L["DelegationAdObjectPlaceholder"]"
                                   autocomplete="off"
                                   data-delegation-object-input />
                            <button type="button" class="btn btn-outline-primary" data-add-delegation-object>
                                @L["AddAdObjectButton"]
                            </button>
                        </div>
                        <div class="delegation-inline-error text-danger d-none" role="status" data-delegation-error></div>
                    </article>
                }
            </div>

            <div class="delegation-new">
                <div class="fw-semibold">@L["NewDelegationHeading"]</div>
                <button type="button"
                        class="btn btn-outline-primary mt-2"
                        aria-haspopup="dialog"
                        aria-controls="delegation-target-dialog"
                        data-open-delegation-picker>
                    @L["AddDelegationButton"]
                </button>
                <div class="delegation-inline-error text-danger d-none" role="status" data-new-delegation-error></div>
            </div>

            <dialog class="delegation-picker-dialog"
                    id="delegation-target-dialog"
                    aria-labelledby="delegation-picker-title"
                    aria-describedby="delegation-picker-description"
                    data-delegation-picker>
                <div class="delegation-picker-header">
                    <div>
                        <div class="delegation-card-eyebrow">Active Directory</div>
                        <h2 class="h5 mb-0" id="delegation-picker-title">@L["DelegationPickerTitle"]</h2>
                    </div>
                    <button type="button"
                            class="kjit-dialog-close"
                            data-close-delegation-picker
                            aria-label="@L["CloseButton"]">
                        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m7 7 10 10" /><path d="m17 7-10 10" /></svg>
                    </button>
                </div>
                <div class="delegation-picker-body">
                    <p class="text-secondary mb-3" id="delegation-picker-description">@L["DelegationPickerDescription"]</p>
                    <div class="delegation-tree-status" role="status" data-delegation-tree-status></div>
                    <div class="delegation-tree" role="tree" aria-label="@L["DelegationPickerTitle"]" data-delegation-tree></div>
                </div>
                <div class="delegation-picker-footer">
                    <button type="button" class="btn btn-outline-secondary" data-close-delegation-picker>
                        @L["DelegationPickerCancel"]
                    </button>
                    <button type="button" class="btn btn-primary" disabled data-select-delegation-target>
                        @L["DelegationPickerSelect"]
                    </button>
                </div>
            </dialog>

            <button type="submit" class="btn btn-primary mt-3">@L["SaveDelegationConfigurationButton"]</button>
        </form>
    </section>
</div>

<template id="delegation-card-template">
    <article class="delegation-card" data-delegation>
        <header class="delegation-card-header">
            <div class="min-w-0">
                <div class="delegation-card-eyebrow">@L["DelegationTargetLabel"]</div>
                <h3 class="delegation-card-title" data-delegation-title></h3>
            </div>
            <button type="button"
                    class="delegation-icon-button delegation-remove-delegation"
                    data-remove-delegation
                    title="@L["DeleteDelegationButton"]"
                    aria-label="@L["DeleteDelegationButton"]">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M3 6h18" /><path d="M8 6V4h8v2" /><path d="M19 6l-1 14H6L5 6" /><path d="M10 11v5M14 11v5" />
                </svg>
            </button>
            <input type="hidden" data-delegation-ou />
        </header>
        <div class="delegation-object-list" data-delegation-object-list></div>
        <div class="delegation-empty" data-delegation-empty>@L["DelegationNoAdObjects"]</div>
        <div class="delegation-add-object input-group">
            <input type="text" class="form-control" placeholder="@L["DelegationAdObjectPlaceholder"]" aria-label="@L["DelegationAdObjectPlaceholder"]" autocomplete="off" data-delegation-object-input />
            <button type="button" class="btn btn-outline-primary" data-add-delegation-object>@L["AddAdObjectButton"]</button>
        </div>
        <div class="delegation-inline-error text-danger d-none" role="status" data-delegation-error></div>
    </article>
</template>

<template id="delegation-object-template">
    <div class="delegation-object" data-delegation-object>
        <span class="delegation-object-icon" aria-hidden="true" data-delegation-object-icon></span>
        <div class="delegation-object-details">
            <strong data-delegation-object-name></strong>
            <span data-delegation-object-sid-label></span>
        </div>
        <input type="hidden" data-delegation-object-sid />
        <button type="button" class="delegation-icon-button" data-remove-delegation-object title="@L["RemoveAdObjectButton"]" aria-label="@L["RemoveAdObjectButton"]">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18" /><path d="M8 6V4h8v2" /><path d="M19 6l-1 14H6L5 6" /></svg>
        </button>
    </div>
</template>

<template id="delegation-tree-node-template">
    <div class="delegation-tree-node" role="treeitem" aria-selected="false" data-delegation-tree-node>
        <div class="delegation-tree-row">
            <button type="button"
                    class="delegation-tree-expand"
                    aria-expanded="false"
                    title="@L["DelegationPickerExpand"]"
                    aria-label="@L["DelegationPickerExpand"]"
                    data-expand-delegation-node>+</button>
            <button type="button" class="delegation-tree-select" data-select-delegation-node>
                <span class="delegation-target-icon" aria-hidden="true" data-delegation-target-icon></span>
                <span class="delegation-target-details">
                    <strong data-delegation-target-name></strong>
                </span>
                <span class="delegation-target-kind" data-delegation-target-kind></span>
            </button>
        </div>
        <div class="delegation-tree-children d-none" role="group" data-delegation-tree-children></div>
    </div>
</template>

<template id="delegation-target-ou-icon-template">
    <svg viewBox="0 0 24 24"><path d="M3 7h7l2 2h9v10H3z" /><path d="M3 7V5h7l2 2" /></svg>
</template>

<template id="delegation-target-computer-icon-template">
    <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="13" rx="1" /><path d="M8 21h8M12 17v4" /></svg>
</template>

<template id="delegation-user-icon-template">
    <svg viewBox="0 0 24 24"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
</template>

<template id="delegation-group-icon-template">
    <svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></svg>
</template>

@section Scripts {
    <script>
        (function () {
            const tabs = document.querySelectorAll('[data-configuration-tab]');
            const panels = document.querySelectorAll('[data-configuration-panel]');

            tabs.forEach(function (tab) {
                tab.addEventListener('click', function () {
                    const selected = tab.dataset.configurationTab;
                    tabs.forEach(function (item) {
                        const active = item.dataset.configurationTab === selected;
                        item.classList.toggle('is-active', active);
                        item.setAttribute('aria-selected', active ? 'true' : 'false');
                    });
                    panels.forEach(function (panel) {
                        panel.classList.toggle(
                            'd-none',
                            panel.dataset.configurationPanel !== selected);
                    });
                });
            });

            const configurationListAdders = new Map();
            document.querySelectorAll('[data-configuration-list]').forEach(function (editor) {
                const select = editor.querySelector('[data-configuration-list-select]');
                const hiddenValue = editor.querySelector('[data-configuration-list-value]');
                const newValue = editor.querySelector('[data-configuration-list-new]');
                const addButton = editor.querySelector('[data-configuration-list-add]');
                const removeButton = editor.querySelector('[data-configuration-list-remove]');
                const singleValue = editor.dataset.singleValue === 'true';

                const updateValue = function () {
                    hiddenValue.value = Array.from(select.options)
                        .map(function (option) { return option.value; })
                        .join(singleValue ? '' : '\n');
                    const hasSelection = select.selectedIndex >= 0;
                    removeButton.disabled = !hasSelection;
                    removeButton.classList.toggle('d-none', !hasSelection);
                };

                const addValue = function (selectedValue) {
                    const value = typeof selectedValue === 'string'
                        ? selectedValue.trim()
                        : newValue?.value.trim();
                    if (!value) {
                        newValue?.focus();
                        return;
                    }

                    if (singleValue) {
                        select.replaceChildren();
                    }

                    const existing = Array.from(select.options).find(function (option) {
                        return option.value.toLocaleLowerCase() === value.toLocaleLowerCase();
                    });
                    const option = existing || new Option(value, value);
                    if (!existing) {
                        select.add(option);
                    }

                    select.value = option.value;
                    if (newValue) {
                        newValue.value = '';
                    }
                    updateValue();
                    select.focus();
                };

                configurationListAdders.set(editor, addValue);
                if (addButton && newValue) {
                    addButton.addEventListener('click', function () { addValue(); });
                    newValue.addEventListener('keydown', function (event) {
                        if (event.key === 'Enter') {
                            event.preventDefault();
                            addValue();
                        }
                    });
                }
                select.addEventListener('change', updateValue);
                removeButton.addEventListener('click', function () {
                    Array.from(select.selectedOptions).forEach(function (option) {
                        option.remove();
                    });
                    if (select.options.length > 0) {
                        select.selectedIndex = 0;
                    }
                    updateValue();
                    select.focus();
                });

                updateValue();
            });

            const configurationDomainsUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("GetConfigurationDomains", "Configuration")));
            const configurationOusUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("BrowseConfigurationOrganizationalUnits", "Configuration")));
            const configurationPickerLoading = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["DelegationPickerLoading"].Value));
            const configurationPickerEmpty = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["DelegationPickerEmpty"].Value));
            const configurationPickerFailed = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["DelegationPickerLoadFailed"].Value));
            const configurationDomainRequired = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["OrganizationalUnitPickerDomainRequired"].Value));
            const configurationOuLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["DelegationTargetOu"].Value));
            const domainEditor = document.querySelector('[data-configuration-picker="domain"]');
            const ouEditor = document.querySelector('[data-configuration-picker="ou"]');
            const domainDialog = document.querySelector('[data-configuration-domain-picker]');
            const domainOptions = document.querySelector('[data-configuration-domain-options]');
            const domainStatus = document.querySelector('[data-configuration-domain-status]');
            const domainSelectButton = document.querySelector('[data-select-configuration-domain]');
            const ouDialog = document.querySelector('[data-configuration-ou-picker]');
            const ouTree = document.querySelector('[data-configuration-ou-tree]');
            const ouStatus = document.querySelector('[data-configuration-ou-status]');
            const ouSelectButton = document.querySelector('[data-select-configuration-ou]');
            let selectedConfigurationDomain;
            let selectedConfigurationOu;
            let configurationOuDomain;

            const setConfigurationPickerStatus = function (element, message, isError) {
                element.textContent = message;
                element.classList.toggle('d-none', !message);
                element.classList.toggle('text-danger', Boolean(isError));
            };

            const openDomainPicker = async function () {
                selectedConfigurationDomain = null;
                domainSelectButton.disabled = true;
                domainOptions.replaceChildren();
                setConfigurationPickerStatus(domainStatus, configurationPickerLoading, false);
                domainDialog.showModal();
                try {
                    const response = await fetch(configurationDomainsUrl, { headers: { 'Accept': 'application/json' } });
                    if (!response.ok) {
                        throw new Error('Domain browse failed.');
                    }
                    const domains = await response.json();
                    domains.forEach(function (domain) {
                        const button = document.createElement('button');
                        button.type = 'button';
                        button.className = 'configuration-picker-option';
                        button.setAttribute('role', 'option');
                        button.setAttribute('aria-selected', 'false');
                        button.textContent = domain;
                        button.dataset.domain = domain;
                        domainOptions.append(button);
                    });
                    setConfigurationPickerStatus(domainStatus, domains.length === 0 ? configurationPickerEmpty : '', false);
                } catch {
                    setConfigurationPickerStatus(domainStatus, configurationPickerFailed, true);
                }
            };

            const browseConfigurationOus = async function (parentDistinguishedName) {
                const parameters = new URLSearchParams({ domainFqdn: configurationOuDomain });
                if (parentDistinguishedName) {
                    parameters.set('parentDistinguishedName', parentDistinguishedName);
                }
                const response = await fetch(configurationOusUrl + '?' + parameters, {
                    headers: { 'Accept': 'application/json' }
                });
                if (!response.ok) {
                    throw new Error('OU browse failed.');
                }
                return response.json();
            };

            const createConfigurationOuNode = function (target) {
                const node = document.querySelector('#delegation-tree-node-template')
                    .content.firstElementChild.cloneNode(true);
                node.dataset.distinguishedName = target.distinguishedName;
                node.dataset.canSelect = target.canSelect ? 'true' : 'false';
                node.querySelector('[data-delegation-target-icon]').append(
                    document.querySelector('#delegation-target-ou-icon-template').content.cloneNode(true));
                node.querySelector('[data-delegation-target-name]').textContent = target.displayName;
                node.querySelector('[data-delegation-target-kind]').textContent = configurationOuLabel;
                node.querySelector('[data-select-delegation-node]').disabled = !target.canSelect;
                return node;
            };

            const renderConfigurationOus = function (container, targets) {
                container.replaceChildren();
                targets.forEach(function (target) {
                    container.append(createConfigurationOuNode(target));
                });
            };

            const openOuPicker = async function () {
                configurationOuDomain = domainEditor?.querySelector('[data-configuration-list-value]').value.trim();
                selectedConfigurationOu = null;
                ouSelectButton.disabled = true;
                ouTree.replaceChildren();
                ouDialog.showModal();
                if (!configurationOuDomain) {
                    setConfigurationPickerStatus(ouStatus, configurationDomainRequired, true);
                    return;
                }

                setConfigurationPickerStatus(ouStatus, configurationPickerLoading, false);
                try {
                    const roots = await browseConfigurationOus();
                    renderConfigurationOus(ouTree, roots);
                    setConfigurationPickerStatus(ouStatus, '', false);
                } catch {
                    setConfigurationPickerStatus(ouStatus, configurationPickerFailed, true);
                }
            };

            document.querySelectorAll('[data-open-configuration-picker]').forEach(function (button) {
                button.addEventListener('click', function () {
                    if (button.dataset.openConfigurationPicker === 'domain') {
                        openDomainPicker();
                    } else {
                        openOuPicker();
                    }
                });
            });

            domainOptions.addEventListener('click', function (event) {
                const option = event.target.closest('[data-domain]');
                if (!option) {
                    return;
                }
                domainOptions.querySelectorAll('[aria-selected="true"]').forEach(function (selected) {
                    selected.setAttribute('aria-selected', 'false');
                });
                option.setAttribute('aria-selected', 'true');
                selectedConfigurationDomain = option.dataset.domain;
                domainSelectButton.disabled = false;
            });

            ouTree.addEventListener('click', async function (event) {
                const node = event.target.closest('[data-delegation-tree-node]');
                if (!node) {
                    return;
                }

                const expandButton = event.target.closest('[data-expand-delegation-node]');
                if (expandButton) {
                    const children = node.querySelector(':scope > [data-delegation-tree-children]');
                    const expanded = expandButton.getAttribute('aria-expanded') === 'true';
                    if (node.dataset.childrenLoaded === 'true') {
                        expandButton.setAttribute('aria-expanded', expanded ? 'false' : 'true');
                        expandButton.textContent = expanded ? '+' : '−';
                        children.classList.toggle('d-none', expanded);
                        return;
                    }
                    expandButton.disabled = true;
                    node.setAttribute('aria-busy', 'true');
                    try {
                        const targets = await browseConfigurationOus(node.dataset.distinguishedName);
                        renderConfigurationOus(children, targets);
                        node.dataset.childrenLoaded = 'true';
                        expandButton.setAttribute('aria-expanded', 'true');
                        expandButton.textContent = '−';
                        children.classList.remove('d-none');
                    } catch {
                        setConfigurationPickerStatus(ouStatus, configurationPickerFailed, true);
                    } finally {
                        expandButton.disabled = false;
                        node.removeAttribute('aria-busy');
                    }
                    return;
                }

                if (event.target.closest('[data-select-delegation-node]') && node.dataset.canSelect === 'true') {
                    ouTree.querySelectorAll('[aria-selected="true"]').forEach(function (selected) {
                        selected.setAttribute('aria-selected', 'false');
                    });
                    node.setAttribute('aria-selected', 'true');
                    selectedConfigurationOu = node.dataset.distinguishedName;
                    ouSelectButton.disabled = false;
                }
            });

            domainSelectButton.addEventListener('click', function () {
                if (selectedConfigurationDomain) {
                    configurationListAdders.get(domainEditor)?.(selectedConfigurationDomain);
                    domainDialog.close();
                }
            });
            ouSelectButton.addEventListener('click', function () {
                if (selectedConfigurationOu) {
                    configurationListAdders.get(ouEditor)?.(selectedConfigurationOu);
                    ouDialog.close();
                }
            });

            document.querySelectorAll('[data-close-configuration-domain-picker]').forEach(function (button) {
                button.addEventListener('click', function () { domainDialog.close(); });
            });
            document.querySelectorAll('[data-close-configuration-ou-picker]').forEach(function (button) {
                button.addEventListener('click', function () { ouDialog.close(); });
            });
            [domainDialog, ouDialog].forEach(function (dialog) {
                dialog.addEventListener('click', function (event) {
                    if (event.target === dialog) {
                        dialog.close();
                    }
                });
            });

            document.querySelectorAll('[data-configuration-number-stepper]').forEach(function (stepper) {
                const input = stepper.querySelector('input[type="number"]');
                stepper.querySelector('[data-step-down]').addEventListener('click', function () {
                    input.stepDown();
                    input.dispatchEvent(new Event('change', { bubbles: true }));
                });
                stepper.querySelector('[data-step-up]').addEventListener('click', function () {
                    input.stepUp();
                    input.dispatchEvent(new Event('change', { bubbles: true }));
                });
            });

            const delegationList = document.querySelector('[data-delegation-list]');
            if (!delegationList) {
                return;
            }

            const delegationForm = delegationList.closest('form');
            const newDelegationError = document.querySelector('[data-new-delegation-error]');
            const resolveUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("ResolveDelegationObject", "Configuration")));
            const browseTargetsUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("BrowseDelegationTargets", "Configuration")));
            const objectNotFoundMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["DelegationAdObjectNotFound"].Value));
            const duplicateObjectMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["DelegationAdObjectDuplicate"].Value));
            const duplicateDelegationMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["DelegationDuplicateOu"].Value));
            const targetOuLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["DelegationTargetOu"].Value));
            const targetComputerLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["DelegationTargetComputer"].Value));
            const pickerLoadingMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["DelegationPickerLoading"].Value));
            const pickerEmptyMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["DelegationPickerEmpty"].Value));
            const pickerLoadFailedMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["DelegationPickerLoadFailed"].Value));
            const pickerDialog = document.querySelector('[data-delegation-picker]');
            const delegationTree = document.querySelector('[data-delegation-tree]');
            const treeStatus = document.querySelector('[data-delegation-tree-status]');
            const pickerSelectButton = document.querySelector('[data-select-delegation-target]');
            let selectedDelegationTarget;

            const showDelegationError = function (element, message) {
                element.textContent = message;
                element.classList.toggle('d-none', !message);
            };

            const updateDelegationEmptyState = function (card) {
                const empty = card.querySelector('[data-delegation-empty]');
                const hasObjects = card.querySelector('[data-delegation-object]') !== null;
                empty.classList.toggle('d-none', hasObjects);
            };

            const reindexDelegations = function () {
                delegationList.querySelectorAll('[data-delegation]').forEach(function (card, delegationIndex) {
                    card.querySelector('[data-delegation-ou]').name = 'Delegations[' + delegationIndex + '].ComputerOu';
                    card.querySelectorAll('[data-delegation-object]').forEach(function (row, objectIndex) {
                        row.querySelector('[data-delegation-object-sid]').name =
                            'Delegations[' + delegationIndex + '].AdObjects[' + objectIndex + '].SecurityIdentifier';
                    });
                });
            };

            const createDelegationObject = function (resolved) {
                const row = document.querySelector('#delegation-object-template').content.firstElementChild.cloneNode(true);
                const icon = row.querySelector('[data-delegation-object-icon]');
                const iconTemplate = document.querySelector(
                    resolved.kind === 'group' ? '#delegation-group-icon-template' : '#delegation-user-icon-template');
                icon.classList.add('is-' + resolved.kind);
                icon.append(iconTemplate.content.cloneNode(true));
                row.querySelector('[data-delegation-object-name]').textContent = resolved.displayName;
                row.querySelector('[data-delegation-object-sid-label]').textContent = resolved.securityIdentifier;
                row.querySelector('[data-delegation-object-sid]').value = resolved.securityIdentifier;
                return row;
            };

            const setTreeStatus = function (message, isError) {
                treeStatus.textContent = message;
                treeStatus.classList.toggle('d-none', !message);
                treeStatus.classList.toggle('text-danger', Boolean(isError));
            };

            const addDelegationCard = function (computerOu) {
                const duplicate = Array.from(delegationList.querySelectorAll('[data-delegation-ou]')).some(function (hidden) {
                    return hidden.value.toLocaleLowerCase() === computerOu.toLocaleLowerCase();
                });
                if (duplicate) {
                    return null;
                }

                const card = document.querySelector('#delegation-card-template').content.firstElementChild.cloneNode(true);
                card.querySelector('[data-delegation-title]').textContent = computerOu;
                card.querySelector('[data-delegation-ou]').value = computerOu;
                delegationList.append(card);
                reindexDelegations();
                return card;
            };

            const createTreeNode = function (target) {
                const node = document.querySelector('#delegation-tree-node-template')
                    .content.firstElementChild.cloneNode(true);
                const isComputer = target.kind === 'computer';
                const iconTemplate = document.querySelector(
                    isComputer ? '#delegation-target-computer-icon-template' : '#delegation-target-ou-icon-template');
                node.dataset.distinguishedName = target.distinguishedName;
                node.dataset.targetKind = target.kind;
                node.querySelector('[data-delegation-target-icon]').append(iconTemplate.content.cloneNode(true));
                node.querySelector('[data-delegation-target-name]').textContent = target.displayName;
                node.querySelector('[data-delegation-target-kind]').textContent =
                    isComputer ? targetComputerLabel : targetOuLabel;

                if (isComputer) {
                    const expandButton = node.querySelector('[data-expand-delegation-node]');
                    expandButton.disabled = true;
                    expandButton.classList.add('is-placeholder');
                    expandButton.textContent = '';
                }
                return node;
            };

            const browseTargets = async function (parentDistinguishedName) {
                const parameters = parentDistinguishedName
                    ? '?' + new URLSearchParams({ parentDistinguishedName: parentDistinguishedName })
                    : '';
                const response = await fetch(browseTargetsUrl + parameters, {
                    headers: { 'Accept': 'application/json' }
                });
                if (!response.ok) {
                    throw new Error('Delegation target browse failed.');
                }
                return response.json();
            };

            const renderTreeTargets = function (container, targets) {
                container.replaceChildren();
                targets.forEach(function (target) {
                    container.append(createTreeNode(target));
                });
            };

            const openDelegationPicker = async function () {
                selectedDelegationTarget = null;
                pickerSelectButton.disabled = true;
                delegationTree.replaceChildren();
                setTreeStatus(pickerLoadingMessage, false);
                pickerDialog.showModal();
                try {
                    const roots = await browseTargets();
                    renderTreeTargets(delegationTree, roots);
                    setTreeStatus(roots.length === 0 ? pickerEmptyMessage : '', false);
                } catch {
                    setTreeStatus(pickerLoadFailedMessage, true);
                }
            };

            const addDelegationObject = async function (card) {
                const input = card.querySelector('[data-delegation-object-input]');
                const button = card.querySelector('[data-add-delegation-object]');
                const error = card.querySelector('[data-delegation-error]');
                const identity = input.value.trim();
                if (!identity) {
                    input.focus();
                    return;
                }

                showDelegationError(error, '');
                button.disabled = true;
                try {
                    const response = await fetch(resolveUrl + '?' + new URLSearchParams({ identity: identity }), {
                        headers: { 'Accept': 'application/json' }
                    });
                    if (!response.ok) {
                        showDelegationError(error, objectNotFoundMessage);
                        return;
                    }

                    const resolved = await response.json();
                    const duplicate = Array.from(card.querySelectorAll('[data-delegation-object-sid]')).some(function (hidden) {
                        return hidden.value.toLocaleLowerCase() === resolved.securityIdentifier.toLocaleLowerCase();
                    });
                    if (duplicate) {
                        showDelegationError(error, duplicateObjectMessage);
                        return;
                    }

                    card.querySelector('[data-delegation-object-list]').append(createDelegationObject(resolved));
                    input.value = '';
                    updateDelegationEmptyState(card);
                    reindexDelegations();
                    input.focus();
                } catch {
                    showDelegationError(error, objectNotFoundMessage);
                } finally {
                    button.disabled = false;
                }
            };

            delegationList.addEventListener('click', function (event) {
                const removeObjectButton = event.target.closest('[data-remove-delegation-object]');
                if (removeObjectButton) {
                    const card = removeObjectButton.closest('[data-delegation]');
                    removeObjectButton.closest('[data-delegation-object]').remove();
                    updateDelegationEmptyState(card);
                    reindexDelegations();
                    return;
                }

                const removeDelegationButton = event.target.closest('[data-remove-delegation]');
                if (removeDelegationButton) {
                    removeDelegationButton.closest('[data-delegation]').remove();
                    reindexDelegations();
                    return;
                }

                const addObjectButton = event.target.closest('[data-add-delegation-object]');
                if (addObjectButton) {
                    addDelegationObject(addObjectButton.closest('[data-delegation]'));
                }
            });

            delegationList.addEventListener('keydown', function (event) {
                if (event.key === 'Enter' && event.target.matches('[data-delegation-object-input]')) {
                    event.preventDefault();
                    addDelegationObject(event.target.closest('[data-delegation]'));
                }
            });

            document.querySelector('[data-open-delegation-picker]').addEventListener('click', function () {
                showDelegationError(newDelegationError, '');
                openDelegationPicker();
            });

            delegationTree.addEventListener('click', async function (event) {
                const node = event.target.closest('[data-delegation-tree-node]');
                if (!node) {
                    return;
                }

                const expandButton = event.target.closest('[data-expand-delegation-node]');
                if (expandButton && !expandButton.disabled) {
                    const children = node.querySelector(':scope > [data-delegation-tree-children]');
                    const expanded = expandButton.getAttribute('aria-expanded') === 'true';
                    if (node.dataset.childrenLoaded === 'true') {
                        expandButton.setAttribute('aria-expanded', expanded ? 'false' : 'true');
                        expandButton.textContent = expanded ? '+' : '−';
                        children.classList.toggle('d-none', expanded);
                        return;
                    }

                    expandButton.disabled = true;
                    node.setAttribute('aria-busy', 'true');
                    try {
                        const targets = await browseTargets(node.dataset.distinguishedName);
                        renderTreeTargets(children, targets);
                        if (targets.length === 0) {
                            const empty = document.createElement('div');
                            empty.className = 'delegation-tree-empty';
                            empty.textContent = pickerEmptyMessage;
                            children.append(empty);
                        }
                        node.dataset.childrenLoaded = 'true';
                        expandButton.setAttribute('aria-expanded', 'true');
                        expandButton.textContent = '−';
                        children.classList.remove('d-none');
                    } catch {
                        setTreeStatus(pickerLoadFailedMessage, true);
                    } finally {
                        expandButton.disabled = false;
                        node.removeAttribute('aria-busy');
                    }
                    return;
                }

                if (event.target.closest('[data-select-delegation-node]')) {
                    delegationTree.querySelectorAll('[data-delegation-tree-node][aria-selected="true"]')
                        .forEach(function (selectedNode) {
                            selectedNode.setAttribute('aria-selected', 'false');
                        });
                    node.setAttribute('aria-selected', 'true');
                    selectedDelegationTarget = {
                        distinguishedName: node.dataset.distinguishedName,
                        kind: node.dataset.targetKind
                    };
                    pickerSelectButton.disabled = false;
                    setTreeStatus('', false);
                }
            });

            document.querySelectorAll('[data-close-delegation-picker]').forEach(function (button) {
                button.addEventListener('click', function () {
                    pickerDialog.close();
                });
            });

            pickerSelectButton.addEventListener('click', function () {
                if (!selectedDelegationTarget) {
                    return;
                }

                const card = addDelegationCard(selectedDelegationTarget.distinguishedName);
                if (!card) {
                    setTreeStatus(duplicateDelegationMessage, true);
                    return;
                }

                pickerDialog.close();
                card.querySelector('[data-delegation-object-input]').focus();
            });

            pickerDialog.addEventListener('click', function (event) {
                if (event.target === pickerDialog) {
                    pickerDialog.close();
                }
            });

            delegationForm.addEventListener('submit', reindexDelegations);
            reindexDelegations();
        })();
    </script>
}
