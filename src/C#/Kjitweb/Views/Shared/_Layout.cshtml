@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject Microsoft.Extensions.Localization.IStringLocalizer<KjitWeb.SharedResource> L
@using System.Globalization
@using System.Reflection
@{
    var informationalVersion = Assembly.GetEntryAssembly()?
        .GetCustomAttribute<AssemblyInformationalVersionAttribute>()?
        .InformationalVersion;
    var applicationVersion = informationalVersion?.Split('+', 2)[0] ?? "unknown";
}

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KjitWeb</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" asp-append-version="true" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <nav class="navbar bg-dark mb-4">
        <div class="container-fluid d-flex justify-content-between align-items-center gap-3">
            <span class="navbar-brand text-white mb-0">@(Configuration["Branding:CompanyName"] ?? "Firma")</span>
            <div class="d-flex align-items-center gap-3">
                <form asp-controller="Home" asp-action="SetLanguage" method="post" class="btn-group btn-group-sm" aria-label="Language">
                    <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                    <button type="submit"
                            name="culture"
                            value="de"
                            class="btn @(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "de" ? "btn-light" : "btn-outline-light")"
                            aria-pressed="@(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "de" ? "true" : "false")">DE</button>
                    <button type="submit"
                            name="culture"
                            value="en"
                            class="btn @(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "btn-light" : "btn-outline-light")"
                            aria-pressed="@(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "true" : "false")">EN</button>
                </form>
                @{
                    var logoPath = Configuration["Branding:LogoPath"];
                    if (!string.IsNullOrEmpty(logoPath))
                    {
                        <img src="@logoPath" alt="Logo" style="height: 40px; max-width: 200px;" />
                    }
                }
            </div>
        </div>
    </nav>
    <div class="container py-4 flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top bg-white py-3 text-secondary">
        <div class="container text-end small d-flex justify-content-end align-items-center gap-2">
            <span id="event-log-health-indicator"
                  class="d-none"
                  role="status"
                  data-ok-title="@L["EventLogStatusOk"]"
                  data-warning-title="@L["EventLogStatusWarning"]"
                  data-error-title="@L["EventLogStatusError"]"></span>
            <span>KjitWeb Version @applicationVersion</span>
        </div>
    </footer>
    <script>
        // Polls the event log health indicator every 5 minutes and shows a symbol next to the
        // version number when Error or Warning entries were logged in the Tier 1 Management event
        // log within the last 24 hours (see HomeController.EventLogHealthStatus).
        (function () {
            var indicator = document.getElementById('event-log-health-indicator');
            if (!indicator) {
                return;
            }

            function applyStatus(level) {
                indicator.classList.remove('text-warning', 'text-danger');
                if (level === 'Error') {
                    indicator.textContent = '\u26D4';
                    indicator.classList.add('text-danger');
                    indicator.title = indicator.dataset.errorTitle;
                    indicator.classList.remove('d-none');
                } else if (level === 'Warning') {
                    indicator.textContent = '\u26A0';
                    indicator.classList.add('text-warning');
                    indicator.title = indicator.dataset.warningTitle;
                    indicator.classList.remove('d-none');
                } else {
                    indicator.textContent = '';
                    indicator.title = indicator.dataset.okTitle;
                    indicator.classList.add('d-none');
                }
            }

            function refreshStatus() {
                fetch('/Home/EventLogHealthStatus', { credentials: 'same-origin' })
                    .then(function (response) { return response.ok ? response.json() : null; })
                    .then(function (data) {
                        if (data) {
                            applyStatus(data.level);
                        }
                    })
                    .catch(function () {
                        // Ignore transient failures; the indicator simply keeps its last known state.
                    });
            }

            refreshStatus();
            setInterval(refreshStatus, 5 * 60 * 1000);
        })();
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
