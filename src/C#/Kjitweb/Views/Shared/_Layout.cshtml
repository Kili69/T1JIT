@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@using System.Globalization
@using System.Reflection
@{
    var informationalVersion = Assembly.GetEntryAssembly()?
        .GetCustomAttribute<AssemblyInformationalVersionAttribute>()?
        .InformationalVersion;
    var applicationVersion = informationalVersion?.Split('+', 2)[0] ?? "unknown";
}

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KjitWeb</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <nav class="navbar bg-dark mb-4">
        <div class="container-fluid d-flex justify-content-between align-items-center gap-3">
            <span class="navbar-brand text-white mb-0">@(Configuration["Branding:CompanyName"] ?? "Firma")</span>
            <div class="d-flex align-items-center gap-3">
                <form asp-controller="Home" asp-action="SetLanguage" method="post" class="btn-group btn-group-sm" aria-label="Language">
                    <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                    <button type="submit"
                            name="culture"
                            value="de"
                            class="btn @(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "de" ? "btn-light" : "btn-outline-light")"
                            aria-pressed="@(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "de" ? "true" : "false")">DE</button>
                    <button type="submit"
                            name="culture"
                            value="en"
                            class="btn @(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "btn-light" : "btn-outline-light")"
                            aria-pressed="@(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "true" : "false")">EN</button>
                </form>
                @{
                    var logoPath = Configuration["Branding:LogoPath"];
                    if (!string.IsNullOrEmpty(logoPath))
                    {
                        <img src="@logoPath" alt="Logo" style="height: 40px; max-width: 200px;" />
                    }
                }
            </div>
        </div>
    </nav>
    <div class="container py-4 flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top bg-white py-3 text-secondary">
        <div class="container text-end small">
            KjitWeb Version @applicationVersion
        </div>
    </footer>
    @RenderSection("Scripts", required: false)
</body>
</html>
