<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SupportedOSPlatforms>windows</SupportedOSPlatforms>
    <NoWarn>CA1416</NoWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1570;CS1572;CS1573;CS1587;CS1591</WarningsAsErrors>
    <Authors>Andreas Lucas</Authors>
    <Copyright>Copyright 2024 Andreas Lucas</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>


  <ItemGroup>
    <!-- HTTP.sys hosts KjitWeb so Windows Authentication (Negotiate/Kerberos/NTLM) runs in
         kernel mode, like IIS. This is required for the service to run under NetworkService:
         the managed Negotiate handler used with Kestrel needs the process to hold the
         computer's own Kerberos/NTLM keys directly (only LocalSystem/domain accounts can do
         that), while HTTP.sys performs the authentication itself and simply hands the app an
         already-authenticated Windows identity. Microsoft.AspNetCore.Server.HttpSys ships as
         part of the Microsoft.AspNetCore.App shared framework since .NET Core 3.0, so no
         separate PackageReference is required (or available) for it.
    -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="System.DirectoryServices.Protocols" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="kjitlogo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>wwwroot\images\kjitlogo.png</TargetPath>
    </Content>
  </ItemGroup>
</Project>
